<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      自动识别交易所需的权限。

      通知使用权（BIND_NOTIFICATION_LISTENER_SERVICE）不是危险权限，
      需用户在系统设置中手动授权，可在系统设置随时撤销。

      短信权限（RECEIVE_SMS）属敏感权限，用于识别银行交易短信。
      应用不联网、不上传，全部解析在本机完成。
    -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      短信权限隐含要求 telephony 硬件。若不显式声明，Google Play 与应用商店
      会把本应用判定为"仅支持带电话功能的手机"，导致平板、折叠屏、ChromeOS
      设备无法安装。required=false 明确告知系统：没有电话硬件也能用，
      只是短信自动识别不可用，其余记账功能正常。
    -->
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <application
        android:name=".OneLedgerApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Suishouji">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Suishouji.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 通知监听：需用户在系统设置中授予「通知使用权」后才生效 -->
        <service
            android:name=".autodetect.PaymentNotificationListener"
            android:exported="true"
            android:label="@string/notification_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- 短信监听：需运行时授予短信权限 -->
        <receiver
            android:name=".autodetect.SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
