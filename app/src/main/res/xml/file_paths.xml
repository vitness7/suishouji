<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!--
      仅允许共享应用私有缓存目录下的更新包。
      不开放外部存储，避免通过 FileProvider 泄露用户文件。
    -->
    <cache-path
        name="updates"
        path="updates/" />

    <!--
      账本导出文件（CSV）。
      同样限制在私有缓存目录内，且只开放 exports 子目录 ——
      更新包与导出文件各有独立授权路径，权限不混用。
    -->
    <cache-path
        name="exports"
        path="exports/" />
</paths>
